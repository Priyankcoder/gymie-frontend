{
  "name": "gymie",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "serve:web": "npx serve dist",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "build:android:preview": "eas build --profile preview --platform android",
    "build:android:production": "eas build --profile production --platform android",
    "build:android:local": "cd android && ./gradlew assembleRelease && cd ..",
    "build:android:local:aab": "cd android && ./gradlew bundleRelease && cd ..",
    "prebuild:android": "npx expo prebuild --platform android",
    "build:list": "eas build:list",
    "android:build": "./build-android.sh",
    "android:build-debug": "cd android && ./gradlew assembleDebug && cd ..",
    "android:build-release": "cd android && ./gradlew assembleRelease && cd ..",
    "android:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "android:install-release": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "android:uninstall": "adb uninstall com.gymie",
    "android:devices": "adb devices",
    "android:logcat": "adb logcat",
    "android:logcat-app": "adb logcat | grep -i gymie",
    "android:clean": "cd android && ./gradlew clean && cd ..",
    "android:studio": "open -a 'Android Studio' android",
    "android:emulator-list": "$ANDROID_HOME/emulator/emulator -list-avds",
    "android:reverse-port": "adb reverse tcp:8080 tcp:8080",
    "android:shake": "adb shell input keyevent 82"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-community/slider": "^5.1.1",
    "@react-native-google-signin/google-signin": "^10.1.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@react-oauth/google": "^0.12.1",
    "@sqlite.org/sqlite-wasm": "^3.51.1-build2",
    "axios": "^1.13.2",
    "expo": "~54.0.28",
    "expo-apple-authentication": "^6.4.2",
    "expo-blur": "^15.0.8",
    "expo-constants": "~18.0.11",
    "expo-file-system": "^19.0.20",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "^17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.10",
    "expo-router": "~6.0.18",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.12",
    "expo-sqlite": "^16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-gifted-charts": "^1.4.70",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "^4.0.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "^0.7.1",
    "react-native-worklets-core": "^1.6.2",
    "uuid": "^13.0.0",
    "wa-sqlite": "^1.0.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "^15.1.3",
    "@react-native-community/cli-platform-android": "^15.1.3",
    "@react-native-community/cli-platform-ios": "^15.1.3",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.19.4",
    "npm": ">=10.0.0"
  },
  "private": true
}
