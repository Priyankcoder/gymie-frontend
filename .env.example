
# Backend API Configuration
# Replace localhost with your computer's IP address when using Expo Go on physical device/simulator

# For local development on same machine (web browser)
# EXPO_PUBLIC_API_URL=http://localhost:8080/v1

# For Expo Go on physical device/simulator
# Find your IP address:
# - macOS/Linux: Run `ifconfig` or `ip addr` and look for your local network IP (e.g., 192.168.1.x)
# - Windows: Run `ipconfig` and look for IPv4 Address (e.g., 192.168.1.x)
# Then use that IP:
EXPO_PUBLIC_API_URL=http://YOUR_LOCAL_IP:8080/v1

# Example:
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8080/v1
