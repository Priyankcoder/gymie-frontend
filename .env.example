# API Configuration for Android Emulator
# Copy this file to .env and update as needed

# For Android Emulator (use 10.0.2.2 to reach host machine)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/v1

# For Physical Device (use your computer's local IP)
# EXPO_PUBLIC_API_URL=http://192.168.x.x:8080/v1

# For Production or ngrok
# EXPO_PUBLIC_API_URL=https://your-api-url.com/v1
